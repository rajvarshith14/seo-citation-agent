# Copy to .env for local development. Keep real credentials out of source control.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=.data/seo_agent.sqlite3

# Hindsight Cloud connection used by the memory workflow.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=seo-citation-agent-demo
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
